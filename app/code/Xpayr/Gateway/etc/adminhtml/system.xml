<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="payment">
            <group id="xpayr_gateway" translate="label" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>XPayr Gateway</label>

                <field id="active" translate="label" sortOrder="1" type="select" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="title" translate="label" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Checkout Title</label>
                </field>

                <field id="api_base_url" translate="label" type="text" sortOrder="3" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>API Base URL</label>
                    <comment><![CDATA[Example: https://xpayr.com/api/v1]]></comment>
                </field>

                <field id="secret_key" translate="label" type="obscure" sortOrder="4" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Secret API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment><![CDATA[Use sk_test_... or sk_live_... key.]]></comment>
                </field>

                <field id="network" translate="label" type="select" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Network Key</label>
                    <source_model>Xpayr\Gateway\Model\Config\Source\Network</source_model>
                    <comment><![CDATA[Loaded from your XPayr account networks.]]></comment>
                </field>

                <field id="currency" translate="label" type="select" sortOrder="6" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Currency Symbol</label>
                    <source_model>Xpayr\Gateway\Model\Config\Source\Currency</source_model>
                    <comment><![CDATA[Loaded from your XPayr account token catalog.]]></comment>
                </field>

                <field id="webhook_secret" translate="label" type="obscure" sortOrder="7" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Webhook Secret</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment><![CDATA[If set, X-XPayr-Signature is verified.]]></comment>
                </field>

                <field id="webhook_auto_sync" translate="label" type="select" sortOrder="8" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Auto-sync webhook on save</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <backend_model>Xpayr\Gateway\Model\Config\Backend\WebhookSync</backend_model>
                    <comment><![CDATA[When enabled, saving this section auto-registers webhook URL and stores returned secret.]]></comment>
                </field>

                <field id="status_order_placed" translate="label,comment" type="select" sortOrder="9" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Placed order status</label>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status\NewStatus</source_model>
                </field>

                <field id="status_order_paid" translate="label,comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Paid order status</label>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status</source_model>
                </field>

                <field id="debug" translate="label" sortOrder="11" type="select" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Debug Log</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
